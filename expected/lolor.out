----------
        0
(1 row)

SELECT lo_tell(:fd);
 lo_tell 
---------
       0
(1 row)

SELECT lowrite(:fd, '<ADDEDDATA>');
 lowrite 
---------
      11
(1 row)

SELECT lo_tell(:fd);
 lo_tell 
---------
      11
(1 row)

SELECT lo_close(:fd);
 lo_close 
----------
        0
(1 row)

END;
BEGIN;
SELECT lo_open(:loid, 262144) AS fd \gset
SELECT convert_from(loread(:fd, 1024), 'UTF8');
             convert_from             
--------------------------------------
 <ADDEDDATA>bcdefghijklmnopqrstuvwxyz
(1 row)

SELECT lo_close(:fd);
 lo_close 
----------
        0
(1 row)

END;
