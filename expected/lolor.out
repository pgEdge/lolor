SELECT lo_open(:span_oid, x'60000'::int) AS fd \gset
SELECT lo_truncate64(:fd, 10);
 lo_truncate64 
---------------
             0
(1 row)

SELECT lo_close(:fd);
 lo_close 
----------
        0
(1 row)

END;
