diff --git a/src/backend/access/heap/heapam.c b/src/backend/access/heap/heapam.c
index 6203e3d7f8d..6c86e061a1c 100644
--- a/src/backend/access/heap/heapam.c
+++ b/src/backend/access/heap/heapam.c
@@ -2805,6 +2805,15 @@ heap_delete(Relation relation, ItemPointer tid,
 				(errcode(ERRCODE_INVALID_TRANSACTION_STATE),
 				 errmsg("cannot delete tuples during a parallel operation")));
 
+	/*
+	 * Like heap_update(), load the replica identity attributes before locking
+	 * the buffer: computing them reads catalogs, which is not allowed while
+	 * a catalog buffer is locked.  Only catalog relations need this.
+	 */
+	if (IsCatalogRelation(relation) && RelationIsLogicallyLogged(relation))
+		bms_free(RelationGetIndexAttrBitmap(relation,
+											INDEX_ATTR_BITMAP_IDENTITY_KEY));
+
 	block = ItemPointerGetBlockNumber(tid);
 	buffer = ReadBuffer(relation, block);
 	page = BufferGetPage(buffer);
